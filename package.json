{
  "name": "@flowlexi/pavedb-client",
  "version": "0.1.3",
  "description": "Minimal JavaScript / TypeScript client for the PaveDB REST API. Zero runtime dependencies, fetch-based.",
  "license": "Apache-2.0",
  "author": "Rodrigo Rodrigues da Silva <rodrigo@flowlexi.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/flowlexi/pavedb-client-js.git"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
